# Backend Environment Variables

# PostgreSQL connection string (Neon, Supabase, or local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/clinic_db

# JWT secret for token signing (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long

# Frontend URL for CORS (set to your Vercel/deployed frontend URL)
FRONTEND_URL=http://localhost:3000

# Server port
PORT=5000

# Environment (development, production)
NODE_ENV=development
